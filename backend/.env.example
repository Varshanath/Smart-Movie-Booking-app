APP_PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/smart_movie_booking

# Base URL of the standalone Python AI agent service (see ../ai-agent).
# Used by src/modules/ai-chat/ai-agent-client.ts.
AI_AGENT_SERVICE_URL=http://localhost:8001

# HMAC secret used to sign/verify auth JWTs (src/modules/auth/token.ts).
# Required — the app fails clearly at token sign/verify time if this is
# unset. Generate a strong random value for real use, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit a real secret here.
JWT_SECRET=replace-with-a-strong-random-secret
