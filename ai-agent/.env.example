# Google AI Studio API key (https://aistudio.google.com/apikey). Required
# unless you configure Vertex AI instead (see below).
GOOGLE_API_KEY=

# Alternative to GOOGLE_API_KEY: use Vertex AI as the model backend instead
# of AI Studio. If you set these three, you can leave GOOGLE_API_KEY blank.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=

# Model id passed to ADK's Agent(model=...).
ADK_MODEL=gemini-2.0-flash

# Host/port this FastAPI service listens on.
AI_AGENT_HOST=0.0.0.0
AI_AGENT_PORT=8001

# Base URL of the existing Node/Express backend. Tools (e.g. get_movies)
# call it over HTTP — this service never connects to Postgres directly.
BACKEND_BASE_URL=http://localhost:4000
